# ═══════════════════════════════════════════════════════════════
# AEGIS-SIGMA Configuration
# Run: ./scripts/setup.sh to configure interactively
# ═══════════════════════════════════════════════════════════════

# ── Consent ────────────────────────────────────────────────────
TELEMETRY=true

# ── Your Sites ────────────────────────────────────────────────
PRIMARY_SITE=https://your-site.com

# ── Backend ────────────────────────────────────────────────────
BACKEND_URL=http://127.0.0.1:8081

# ── Strike Server ─────────────────────────────────────────────
STRIKE_URL=local

# ── Data Paths ────────────────────────────────────────────────
DATA_DIR=./data
LOG_DIR=./logs
MODELS_DIR=./models
VAULT_DIR=./vault

# ── LLM (optional, for teacher) ───────────────────────────────
LLM_KEY=
LLM_URL=
LLM_MODEL=
