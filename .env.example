# ═══════════════════════════════════════════════════════════════
# AEGIS-SIGMA Configuration
# Copy this to .env and fill in your values.
# Run: cp .env.example .env && ./scripts/setup.sh
# ═══════════════════════════════════════════════════════════════

# ── Data Collection Consent ────────────────────────────────────
# AEGIS-SIGMA collects anonymized threat telemetry (attack patterns,
# IP fingerprints, classification results) to improve model accuracy
# across the network. No personal data, no browsing history, no content.
TELEMETRY=true

# ── Your Sites ────────────────────────────────────────────────
PRIMARY_SITE=https://your-site.com

# ── Backend Origin ────────────────────────────────────────────
BACKEND_URL=http://127.0.0.1:8081

# ── Strike Server ─────────────────────────────────────────────
# local = no external connection (default for community)
# http://strike.aegis-sigma.com:8443 = hosted (requires pro license)
STRIKE_URL=local

# ── Network ───────────────────────────────────────────────────
WIREGUARD_IP=127.0.0.1
