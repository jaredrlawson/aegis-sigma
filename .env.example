# ═══════════════════════════════════════════════════════════════
# AEGIS-SIGMA Configuration
# Copy this to .env and fill in your values.
# Run: cp .env.example .env && ./scripts/setup.sh
# ═══════════════════════════════════════════════════════════════

# ── Data Collection Consent ────────────────────────────────────
# AEGIS-SIGMA collects anonymized threat telemetry (attack patterns,
# IP fingerprints, classification results) to improve model accuracy
# across the network. No personal data, no browsing history, no content.
# Set to 'false' to disable telemetry (fully local operation).
TELEMETRY=true

# ── Your Sites ────────────────────────────────────────────────
PRIMARY_SITE=https://your-site.com
SECONDARY_SITE=

# ── Backend Origin ────────────────────────────────────────────
BACKEND_URL=http://127.0.0.1:8081

# ── Strike Server ─────────────────────────────────────────────
# Community: local tracker only (no external server)
# Pro: hosted GCP strike server (requires license)
STRIKE_URL=local

# ── LLM Gateway (for Teacher) ────────────────────────────────
LLM_BASE_URL=

# ── Email ─────────────────────────────────────────────────────
EMAIL_FROM=shield@localhost
EMAIL_NAME=AEGIS Security

# ── SMTP (fallback when Brevo/Resend unavailable) ────────────
SMTP_HOST=127.0.0.1
SMTP_PORT=25
